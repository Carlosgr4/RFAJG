rules_version = '2';

// Reglas de Firebase Storage (fotos de perfumes).
// Cópialas en: Consola de Firebase > Storage > Reglas > Publicar.
service firebase.storage {
  match /b/{bucket}/o {
    match /perfumes/{archivo} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.token.email == 'admin@rfragancias.app'
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null
        && request.auth.token.email == 'admin@rfragancias.app';
    }
  }
}
