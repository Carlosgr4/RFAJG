<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <LinearLayout
        android:id="@+id/encabezado_carrito"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/surface"
        android:paddingHorizontal="@dimen/padding_screen"
        android:paddingTop="28dp"
        android:paddingBottom="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/eyebrow_catalogo"
            style="@style/TextEyebrow" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/titulo_carrito"
            android:textSize="26sp"
            style="@style/TextDisplay" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_carrito"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/encabezado_carrito"
        android:layout_above="@id/contenedor_total"
        android:paddingTop="@dimen/spacing_md"
        android:clipToPadding="false" />

    <TextView
        android:id="@+id/texto_carrito_vacio"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:gravity="center"
        android:paddingHorizontal="@dimen/padding_screen"
        android:text="@string/carrito_vacio"
        android:visibility="gone"
        style="@style/TextBodyMuted" />

    <LinearLayout
        android:id="@+id/contenedor_total"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="vertical"
        android:background="@color/surface"
        android:padding="@dimen/padding_screen">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/carrito_total"
                android:textColor="@color/text_muted"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/texto_total_carrito"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_confirmar_pedido"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:backgroundTint="@color/whatsapp"
            android:text="@string/btn_confirmar_pedido"
            android:textColor="@color/white"
            app:icon="@drawable/ic_whatsapp"
            app:iconTint="@color/white" />

    </LinearLayout>

</RelativeLayout>
