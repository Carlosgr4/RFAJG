<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipe_refresh"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Encabezado -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@color/surface"
                    android:paddingHorizontal="@dimen/padding_screen"
                    android:paddingTop="28dp"
                    android:paddingBottom="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/eyebrow_catalogo"
                        style="@style/TextEyebrow" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/titulo_catalogo"
                        android:textSize="28sp"
                        style="@style/TextDisplay" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/subtitulo_catalogo"
                        style="@style/TextBodyMuted" />
                </LinearLayout>

                <!-- Buscador -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_search"
                    android:layout_marginHorizontal="@dimen/padding_screen"
                    android:layout_marginTop="@dimen/spacing_md"
                    android:paddingHorizontal="14dp"
                    android:layout_marginBottom="@dimen/spacing_sm">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_search" />

                    <EditText
                        android:id="@+id/edit_buscar"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:layout_marginStart="10dp"
                        android:background="@android:color/transparent"
                        android:hint="@string/hint_buscar"
                        android:textColorHint="@color/text_muted"
                        android:textColor="@color/text_primary"
                        android:singleLine="true"
                        android:imeOptions="actionSearch"
                        android:inputType="text" />
                </LinearLayout>

                <!-- Filtros por género -->
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none"
                    android:paddingHorizontal="@dimen/padding_screen"
                    android:layout_marginBottom="@dimen/spacing_md">

                    <LinearLayout
                        android:id="@+id/contenedor_filtros"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </HorizontalScrollView>

                <!-- Grid de perfumes -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recycler_perfumes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="12dp"
                    android:clipToPadding="false"
                    android:nestedScrollingEnabled="false" />

                <TextView
                    android:id="@+id/texto_vacio"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="40dp"
                    android:gravity="center"
                    android:text="@string/catalogo_vacio"
                    android:visibility="gone"
                    style="@style/TextBodyMuted" />

                <!-- Contacto -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_card"
                    android:layout_margin="@dimen/padding_screen"
                    android:padding="@dimen/padding_card">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/eyebrow_catalogo"
                        style="@style/TextEyebrow" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="¿Tienes dudas o quieres separar tu fragancia favorita?"
                        android:textSize="20sp"
                        style="@style/TextDisplay" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_whatsapp_contacto"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:backgroundTint="@color/whatsapp"
                        android:text="@string/btn_whatsapp"
                        android:textColor="@color/white"
                        app:icon="@drawable/ic_whatsapp"
                        app:iconTint="@color/white" />
                </LinearLayout>

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_whatsapp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="20dp"
        android:src="@drawable/ic_whatsapp"
        app:tint="@color/white"
        app:backgroundTint="@color/whatsapp" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
